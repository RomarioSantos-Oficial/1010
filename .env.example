APP_ENV=development
DATABASE_PATH=data/app.db
CATALOG_PATH=data/catalog.db
LLM_PROVIDER=llama_server
LLM_MODEL_PATH=models/llm/model.gguf
LLM_CONTEXT_SIZE=4096
LLM_GPU_LAYERS=-1
LLAMA_SERVER_PORT=8081
QDRANT_PATH=data/qdrant
EMBEDDING_MODEL=models/embeddings/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_MEMORY_ENABLED=true
MEMORY_SIMILARITY_THRESHOLD=0.88
STT_MODEL_PATH=models/stt/faster-whisper-small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_ENABLED=true
TTS_PROVIDER=kokoro
TTS_KOKORO_MODEL_DIR=models/tts/kokoro-82m
TTS_VOICE=pf_dora
TTS_LANGUAGE=p
TTS_DEVICE=cpu
TTS_SPEED=1.0
TTS_MODEL_PATH=models/tts/pt_BR-faber-medium.onnx
TTS_USE_CUDA=false
TTS_LENGTH_SCALE=1.0
MAX_AUDIO_BYTES=20971520
AVATAR_SPRITE_URL=/assets/avatar/luna_sprite_v1_1.png
HISTORY_LIMIT=16
MEMORY_LIMIT=6
HOST=127.0.0.1
PORT=8000
